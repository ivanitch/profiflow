# ==========================================
# INFRASTRUCTURE VERSIONS
# ==========================================
POSTGRES_VERSION=18-alpine
REDIS_VERSION=8-alpine
PYTHON_VERSION=3.14-slim
NODE_VERSION=26-slim

# ==========================================
# DJANGO CORE (LOCAL)
# ==========================================
ENVIRONMENT=local
DEBUG=True

# Leave empty if you want to use the default insecure key for local development
SECRET_KEY=

# For local development, allow everything
ALLOWED_HOSTS=*

# ==========================================
# APP SETTINGS
# ==========================================
APP_NAME="ProfiFlow"
APP_TITLE="ProfiFlow 🦋 сервис онлайн-записи для бьюти-мастеров и студий"

TIME_ZONE=Europe/Moscow
LOG_LEVEL=DEBUG

# ==========================================
# DATABASE & CACHE
# ==========================================
# These values are used by both the Docker container and Django
POSTGRES_DB=profiflow_pro
POSTGRES_USER=profiflow_pro_user
POSTGRES_PASSWORD=profiflow_pro_pass

# Format: postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://profiflow_pro_user:profiflow_pro_pass@db:5432/profiflow_pro

CACHE_ENABLED=True
REDIS_URL=redis://redis:6379/1

# ==========================================
# DOCKER UID/GID (optional, for Linux)
# ==========================================
# UID=1000
# GID=1000
